{
  "manifest_version": 3,
  "name": "IndiGo BluChip Fare Tracker",
  "version": "1.0.0",
  "description": "Scans IndiGo BluChip points pricing across your configured routes and dates, ranked cheapest first - on-demand or on an automatic schedule, entirely inside your own logged-in browser session.",
  "permissions": ["tabs", "storage", "alarms", "notifications"],
  "host_permissions": ["https://www.goindigo.in/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IndiGo BluChip Fare Tracker",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://www.goindigo.in/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
